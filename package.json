{
    "devDependencies": {
        "@babel/core": "^8.0.1",
        "@babel/preset-env": "^8.0.2",
        "@eslint/js": "^10.0.1",
        "@symfony/webpack-encore": "^7.2.0",
        "bootstrap": "^5.3.8",
        "date-fns": "^4.4.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-webpack-plugin": "^6.0.0",
        "glob": "^13.0.6",
        "globals": "^17.11.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.3.0",
        "prettier": "^3.9.6",
        "purgecss-webpack-plugin": "^8.0.0",
        "sass": "^1.102.0",
        "sass-loader": "^17.0.0",
        "webpack": "^5.109.2",
        "webpack-cli": "^7.2.2"
    },
    "license": "MIT",
    "private": true,
    "scripts": {
        "prepare": "husky install",
        "dev-server": "encore dev-server",
        "dev": "encore dev",
        "watch": "encore dev --watch",
        "build": "encore production",
        "prettier:fix": "prettier --write '**/*.{js,json,scss,css,md}'",
        "prettier:ci": "prettier --check '**/*.{js,json,scss,css,md}'",
        "eslint:ci": "eslint .",
        "eslint:fix": "eslint --fix ."
    },
    "lint-staged": {
        "*.js": [
            "eslint",
            "prettier --write"
        ],
        "*.{json,scss,css,md}": [
            "prettier --write"
        ]
    },
    "type": "module"
}
